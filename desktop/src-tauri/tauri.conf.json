{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinguaPulse",
  "version": "1.0.0",
  "identifier": "com.linguapulse.desktop",
  "build": {},
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LinguaPulse",
        "url": "https://linguapulse.yyds.kim",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "LinguaPulse 英语学习客户端",
    "longDescription": "LinguaPulse 桌面客户端：听写练习、语法拆解、TTS 语音学习",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}

# ── LinguaPulse 生产环境变量 ──
# 复制到服务器后根据实际情况修改

# ═══════════════════════════════════
# 数据库（宿主机 PostgreSQL）
# ═══════════════════════════════════
# host.docker.internal = 容器访问宿主机的固定地址
# 前提：宿主机 PG 需允许 Docker 网段连接
#   → postgresql.conf: listen_addresses = '*'
#   → pg_hba.conf: host all all 172.17.0.0/16 md5
DATABASE_URL=postgresql+asyncpg://root:your_password@host.docker.internal:5432/linguapulse

# ═══════════════════════════════════
# JWT（⚠️ 务必改为随机字符串！）
# 生成：openssl rand -hex 32
# ═══════════════════════════════════
JWT_SECRET=change-me-in-production

# ═══════════════════════════════════
# 应用
# ═══════════════════════════════════
APP_NAME=LinguaPulse
DEBUG=false

# TTS 音频缓存（容器内路径，不需要改）
AUDIO_DIR=/app/static/audio

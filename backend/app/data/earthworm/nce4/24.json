      },
      {
        "text": "labour",
        "role": "O",
        "phonetic": "/ˈleɪbə/",
        "chinese": ""
      },
      {
        "text": "as a moral obligation",
        "role": "C",
        "phonetic": "/æz ə ˈmɒrəl ˌɒblɪˈɡeɪʃn/",
        "chinese": "当…时/作为/因为/一个"
      },
      {
        "text": "not merely a means of subsistence",
        "role": "C",
